{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoreTracker completed games v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "games"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "games": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/game"
      }
    }
  },
  "$defs": {
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "table",
        "started_at",
        "ended_at",
        "duration_ms",
        "source",
        "scores"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "rom": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "source": {
          "enum": [
            "pinmame",
            "table_script"
          ]
        },
        "scores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 1
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 2
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 3
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 4
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 5
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 6
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 7
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/score"
                },
                {
                  "properties": {
                    "player": {
                      "const": 8
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "pinmame"
              }
            }
          },
          "then": {
            "required": [
              "rom"
            ]
          }
        }
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player",
        "score"
      ],
      "properties": {
        "player": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
